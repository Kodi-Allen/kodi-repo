# proxy-host LAN address. Ports are deliberately bound to this address instead
# of 0.0.0.0 and must not be forwarded by the router.
GEOTV_BIND_ADDRESS=192.0.2.10
TZ=Europe/Vienna

# PrivadoVPN service credentials (not the website password).
OPENVPN_USER=replace-me
OPENVPN_PASSWORD=replace-me

# Gluetun CONNECT proxy credentials used by the Tubi Kodi add-on.
HTTPPROXY_USER=kodi
HTTPPROXY_PASSWORD=replace-with-a-long-random-password

# 32-byte-or-longer random key shared only by the relay and the Kodi add-on.
# Generate with: openssl rand -hex 32
RELAY_SIGNING_KEY=replace-with-at-least-32-random-characters

# Public address embedded into the HLS playlists returned to Kodi.
RELAY_PUBLIC_BASE=http://192.0.2.10:8893
RELAY_URL_TTL=86400
