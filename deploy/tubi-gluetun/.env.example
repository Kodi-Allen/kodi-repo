# Generate and download a Mullvad WireGuard configuration. Copy PrivateKey
# and the FIRST (IPv4) value from Address in its [Interface] section.
# Never paste the private key into chat or commit this .env file.
WIREGUARD_PRIVATE_KEY=replace-with-private-key-from-mullvad-config
WIREGUARD_ADDRESSES=10.64.x.x/32

# Optional narrowing within the United States. Leave both empty to let
# Gluetun select any US Mullvad WireGuard server.
SERVER_CITIES=
SERVER_HOSTNAMES=

# 127.0.0.1 if Kodi and Docker share a host. Otherwise use the Docker host's
# LAN address, for example 192.0.2.30. Never expose port 8888 publicly.
GLUETUN_BIND_ADDRESS=127.0.0.1

# Optional but recommended if the proxy is reachable by other LAN devices.
# Kodi stores these values unencrypted in its settings file.
HTTPPROXY_USER=
HTTPPROXY_PASSWORD=
HTTPPROXY_LOG=off

TZ=Europe/Vienna
