# Use the manual VPN username shown in the Privado admin panel, NOT the email
# address, plus the corresponding manual VPN password. Keep .env local.
OPENVPN_USER=replace-with-privado-vpn-username
OPENVPN_PASSWORD=replace-with-privado-vpn-password

# 127.0.0.1 if Kodi and Docker both run on proxy-host. Otherwise use
# proxy-host's LAN IP, for example 192.0.2.20.
GLUETUN_BIND_ADDRESS=127.0.0.1

# Optional proxy authentication, recommended when another LAN device can
# reach the proxy. Kodi stores these values unencrypted in its settings.
HTTPPROXY_USER=
HTTPPROXY_PASSWORD=
HTTPPROXY_LOG=off

TZ=Europe/Vienna
