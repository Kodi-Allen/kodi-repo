<?xml version="1.0" encoding="UTF-8"?>
<!-- Joyn search: same header and poster language as JoynHome.xml. -->
<window>
    <defaultcontrol>400</defaultcontrol>
    <backgroundcolor>FF0B0E14</backgroundcolor>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="FF0B0E14">joyn-white.png</texture>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <aspectratio>scale</aspectratio>
            <texture background="true">$INFO[Container(500).ListItem.Art(fanart)]</texture>
            <fadetime>250</fadetime>
            <visible>Integer.IsGreater(Container(500).NumItems,0)</visible>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="B30B0E14">joyn-white.png</texture>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>660</height>
            <texture colordiffuse="A6006B62">joyn-ambient.png</texture>
        </control>
        <control type="image">
            <left>100</left><top>24</top><width>76</width><height>32</height>
            <aspectratio>keep</aspectratio>
            <texture>joyn-logo.png</texture>
        </control>
        <!-- Navbar exactly as on Home; DOWN leads to the search field. -->
        <control type="grouplist" id="9300">
            <left>264</left><top>20</top><width>1160</width><height>40</height>
            <orientation>horizontal</orientation><itemgap>37</itemgap>
            <onright>307</onright><ondown>400</ondown>
            <control type="button" id="301">
                <width>auto</width><height>40</height>
                <texturefocus border="0,0,0,3">joyn-underline.png</texturefocus><texturenofocus />
                <label>$ADDON[plugin.video.joyn.kodiallen 30210]</label><font>font13</font><textoffsetx>0</textoffsetx><aligny>center</aligny>
                <textcolor>FFC0C0C0</textcolor><focusedcolor>FFF0F0F0</focusedcolor>
                <ondown>400</ondown>
            </control>
            <control type="button" id="302">
                <width>auto</width><height>40</height>
                <texturefocus border="0,0,0,3">joyn-underline.png</texturefocus><texturenofocus />
                <label>$ADDON[plugin.video.joyn.kodiallen 30211]</label><font>font13</font><textoffsetx>0</textoffsetx><aligny>center</aligny>
                <textcolor>FFC0C0C0</textcolor><focusedcolor>FFF0F0F0</focusedcolor>
                <ondown>400</ondown>
            </control>
            <control type="button" id="303">
                <width>auto</width><height>40</height>
                <texturefocus border="0,0,0,3">joyn-underline.png</texturefocus><texturenofocus />
                <label>$ADDON[plugin.video.joyn.kodiallen 30212]</label><font>font13</font><textoffsetx>0</textoffsetx><aligny>center</aligny>
                <textcolor>FFC0C0C0</textcolor><focusedcolor>FFF0F0F0</focusedcolor>
                <ondown>400</ondown>
            </control>
            <control type="button" id="304">
                <width>auto</width><height>40</height>
                <texturefocus border="0,0,0,3">joyn-underline.png</texturefocus><texturenofocus />
                <label>$ADDON[plugin.video.joyn.kodiallen 30213]</label><font>font13</font><textoffsetx>0</textoffsetx><aligny>center</aligny>
                <textcolor>FFC0C0C0</textcolor><focusedcolor>FFF0F0F0</focusedcolor>
                <ondown>400</ondown>
            </control>
            <control type="button" id="305">
                <width>auto</width><height>40</height>
                <texturefocus border="0,0,0,3">joyn-underline.png</texturefocus><texturenofocus />
                <label>$ADDON[plugin.video.joyn.kodiallen 30214]</label><font>font13</font><textoffsetx>0</textoffsetx><aligny>center</aligny>
                <textcolor>FFC0C0C0</textcolor><focusedcolor>FFF0F0F0</focusedcolor>
                <ondown>400</ondown>
            </control>
            <control type="button" id="306">
                <width>auto</width><height>40</height>
                <texturefocus border="0,0,0,3">joyn-underline.png</texturefocus><texturenofocus />
                <label>$ADDON[plugin.video.joyn.kodiallen 30215]</label><font>font13</font><textoffsetx>0</textoffsetx><aligny>center</aligny>
                <textcolor>FFC0C0C0</textcolor><focusedcolor>FFF0F0F0</focusedcolor>
                <ondown>400</ondown>
            </control>
        </control>
        <control type="button" id="307">
            <left>1440</left><top>20</top><width>380</width><height>40</height>
            <texturefocus colordiffuse="33F0F0F0">joyn-white.png</texturefocus><texturenofocus />
            <label>$ADDON[plugin.video.joyn.kodiallen 30216]: [B]$INFO[Window.Property(joyn.search.region)][/B]</label><font>font13</font>
            <align>right</align><aligny>center</aligny><textoffsetx>16</textoffsetx>
            <textcolor>FFC0C0C0</textcolor><focusedcolor>FFF0F0F0</focusedcolor>
            <onleft>306</onleft><ondown>400</ondown>
        </control>
        <!-- Search field: SELECT opens Kodi's keyboard. Focus: 3px white frame. -->
        <control type="image">
            <left>97</left><top>105</top><width>1726</width><height>78</height>
            <texture colordiffuse="FFF0F0F0">joyn-white.png</texture>
            <visible>Control.HasFocus(400)</visible>
        </control>
        <control type="button" id="400">
            <left>100</left><top>108</top><width>1720</width><height>72</height>
            <texturenofocus colordiffuse="FF252830">joyn-white.png</texturenofocus>
            <texturefocus colordiffuse="FF252830">joyn-white.png</texturefocus>
            <label>$INFO[Window.Property(joyn.search.field)]</label>
            <font>font13</font><textoffsetx>28</textoffsetx><aligny>center</aligny>
            <textcolor>FFC0C0C0</textcolor><focusedcolor>FFF0F0F0</focusedcolor>
            <onup>306</onup><ondown>500</ondown>
        </control>
        <!-- One line under the field: status while searching, else the focused title. -->
        <control type="label">
            <left>100</left><top>192</top><width>1720</width><height>44</height>
            <font>font13</font><textcolor>FFC0C0C0</textcolor>
            <label>$INFO[Window.Property(joyn.search.status)]</label>
            <visible>!Control.HasFocus(500)</visible>
        </control>
        <control type="label">
            <left>100</left><top>192</top><width>1720</width><height>44</height>
            <font>font13</font><textcolor>FFF0F0F0</textcolor>
            <label>[B]$INFO[Container(500).ListItem.Label][/B]$INFO[Container(500).ListItem.Year,[COLOR FFC0C0C0]   ,[/COLOR]]</label>
            <visible>Control.HasFocus(500)</visible>
        </control>
        <!-- Results: six 288px cells per row as in Home's rows; poster 256x384,
             focused artwork 274x411 (+7 %) with a 3px frame. Kodi's panel moves
             LEFT/RIGHT within a row and UP/DOWN between rows natively. -->
        <control type="panel" id="500">
            <left>88</left><top>236</top><width>1728</width><height>844</height>
            <offsetx>8</offsetx><offsety>16</offsety>
            <orientation>vertical</orientation>
            <onup>400</onup><onleft>500</onleft><onright>500</onright>
            <scrolltime tween="sine">200</scrolltime>
            <itemlayout width="288" height="422">
                <control type="image">
                    <left>4</left><top>4</top><width>256</width><height>384</height>
                    <texture colordiffuse="FF252830">joyn-white.png</texture>
                </control>
                <control type="image">
                    <left>4</left><top>4</top><width>256</width><height>384</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[Window.Property(joyn.fallback)]</texture>
                </control>
                <control type="image">
                    <left>4</left><top>4</top><width>256</width><height>384</height>
                    <aspectratio>keep</aspectratio>
                    <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                </control>
            </itemlayout>
            <focusedlayout width="288" height="422">
                <control type="image">
                    <left>-8</left><top>-12.5</top><width>280</width><height>417</height>
                    <texture colordiffuse="FFF0F0F0">joyn-white.png</texture>
                    <visible>Control.HasFocus(500)</visible>
                </control>
                <control type="image">
                    <left>-5</left><top>-9.5</top><width>274</width><height>411</height>
                    <texture colordiffuse="FF252830">joyn-white.png</texture>
                    <visible>Control.HasFocus(500)</visible>
                </control>
                <control type="image">
                    <left>-5</left><top>-9.5</top><width>274</width><height>411</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[Window.Property(joyn.fallback)]</texture>
                    <visible>Control.HasFocus(500)</visible>
                </control>
                <control type="image">
                    <left>-5</left><top>-9.5</top><width>274</width><height>411</height>
                    <aspectratio>keep</aspectratio>
                    <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                    <visible>Control.HasFocus(500)</visible>
                </control>
                <control type="image">
                    <left>4</left><top>4</top><width>256</width><height>384</height>
                    <texture colordiffuse="FF252830">joyn-white.png</texture>
                    <visible>!Control.HasFocus(500)</visible>
                </control>
                <control type="image">
                    <left>4</left><top>4</top><width>256</width><height>384</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[Window.Property(joyn.fallback)]</texture>
                    <visible>!Control.HasFocus(500)</visible>
                </control>
                <control type="image">
                    <left>4</left><top>4</top><width>256</width><height>384</height>
                    <aspectratio>keep</aspectratio>
                    <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                    <visible>!Control.HasFocus(500)</visible>
                </control>
            </focusedlayout>
        </control>
    </controls>
</window>
