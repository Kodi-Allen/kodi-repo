<?xml version="1.0" encoding="UTF-8"?>
<window>
    <defaultcontrol always="true">100</defaultcontrol>
    <backgroundcolor>FF101218</backgroundcolor>
    <controls>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="FF101218">tubi-white.png</texture>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <aspectratio>scale</aspectratio>
            <texture background="true">$INFO[Container(100).ListItem.Art(fanart)]</texture>
            <fadetime>250</fadetime>
        </control>
        <control type="image">
            <left>0</left><top>0</top><width>1920</width><height>1080</height>
            <texture colordiffuse="B3101218">tubi-white.png</texture>
        </control>
        <control type="label">
            <left>100</left><top>96</top><width>1720</width><height>64</height>
            <font>font13</font><textcolor>FFF0F0F0</textcolor>
            <label>[B]TUBI[/B]</label>
        </control>
        <control type="label">
            <left>100</left><top>228</top><width>1720</width><height>48</height>
            <font>font13</font><textcolor>FFF0F0F0</textcolor>
            <label>$INFO[Window.Property(tubi.row)]</label>
        </control>
        <control type="label">
            <left>100</left><top>300</top><width>1720</width><height>64</height>
            <font>font13</font><textcolor>FFC0C0C0</textcolor>
            <label>$INFO[Window.Property(tubi.status)]</label>
        </control>
        <!-- Six unchanged 288px cells; normal poster 256x384, gap 32.
             Only the focused artwork grows to 268x402 (104.6875%).
             Extra clipping room + offsets preserve the row origin (96,300). -->
        <control type="list" id="100">
            <left>88</left><top>284</top><width>1728</width><height>476</height>
            <offsetx>8</offsetx><offsety>16</offsety>
            <orientation>horizontal</orientation>
            <onleft>100</onleft><onright>100</onright>
            <onup>100</onup><ondown>100</ondown>
            <scrolltime>0</scrolltime>
            <itemlayout width="288" height="460">
                <control type="image">
                    <left>4</left><top>4</top><width>256</width><height>384</height>
                    <texture colordiffuse="FF252830">tubi-white.png</texture>
                </control>
                <control type="image">
                    <left>4</left><top>4</top><width>256</width><height>384</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[Window.Property(tubi.fallback)]</texture>
                </control>
                <control type="image">
                    <left>4</left><top>4</top><width>256</width><height>384</height>
                    <aspectratio>keep</aspectratio>
                    <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                </control>
            </itemlayout>
            <focusedlayout width="288" height="460">
                <control type="image">
                    <left>-6</left><top>-9</top><width>276</width><height>410</height>
                    <texture colordiffuse="FFF0F0F0">tubi-white.png</texture>
                </control>
                <control type="image">
                    <left>-2</left><top>-5</top><width>268</width><height>402</height>
                    <texture colordiffuse="FF252830">tubi-white.png</texture>
                </control>
                <control type="image">
                    <left>-2</left><top>-5</top><width>268</width><height>402</height>
                    <aspectratio>keep</aspectratio>
                    <texture>$INFO[Window.Property(tubi.fallback)]</texture>
                </control>
                <control type="image">
                    <left>-2</left><top>-5</top><width>268</width><height>402</height>
                    <aspectratio>keep</aspectratio>
                    <texture background="true">$INFO[ListItem.Art(poster)]</texture>
                </control>
                <control type="label">
                    <left>4</left><top>410</top><width>256</width><height>48</height>
                    <font>font13</font><textcolor>FFF0F0F0</textcolor>
                    <label>$INFO[ListItem.Label]</label><scroll>false</scroll>
                </control>
            </focusedlayout>
        </control>
    </controls>
</window>
